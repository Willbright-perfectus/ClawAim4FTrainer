; ClawLab — editable mobile aiming and movement trainer.
config_version=5

[application]
config/name="ClawLab"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]
Profiles="*res://scripts/profile_store.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=648
window/size/window_width_override=1440
window/size/window_height_override=648
window/stretch/mode="canvas_items"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.043, 0.063, 1)

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true
sensors/enable_gyroscope=true

[audio]
driver/enable_input=false

